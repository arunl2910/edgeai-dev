{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EdgeAI Model Manifest",
  "type": "object",
  "required": ["task", "artifact"],
  "properties": {
    "task": { "type": "string" },
    "io": {
      "type": "object",
      "properties": {
        "input": { "type": "string" },
        "output": { "type": "string" }
      }
    },
    "pre": { "type": "array", "items": { "type": "string" } },
    "post": { "type": "array", "items": { "type": "string" } },
    "artifact": {
      "type": "object",
      "required": ["path", "format"],
      "properties": {
        "path": { "type": "string" },
        "format": { "type": "string" }
      }
    }
  }
}
