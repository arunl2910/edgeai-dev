{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EdgeAI Pipeline Template",
  "type": "object",
  "required": ["pipeline", "nodes", "edges"],
  "properties": {
    "pipeline": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "params": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    }
  }
}
